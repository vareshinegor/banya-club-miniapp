# Токен бота из @BotFather
BOT_TOKEN=

# ID Google Таблицы (из её URL: https://docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit)
GOOGLE_SHEETS_ID=

# Путь к JSON-ключу сервисного аккаунта Google
GOOGLE_CREDENTIALS_FILE=credentials.json

# Случайная строка для подписи сессий Flask (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# true — включает обход Telegram-авторизации через ?dev_id=... для локальной отладки в браузере
DEV_MODE=false

PORT=5000

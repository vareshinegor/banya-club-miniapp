# Токен бота из @BotFather
BOT_TOKEN=

# ID Google Таблицы (из её URL: https://docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit)
GOOGLE_SHEETS_ID=

# Путь к JSON-ключу сервисного аккаунта Google (локальная разработка — файл
# credentials.json лежит рядом, в .gitignore).
GOOGLE_CREDENTIALS_FILE=credentials.json

# На Railway (или любом хостинге без файла credentials.json в репозитории)
# вместо GOOGLE_CREDENTIALS_FILE задайте эту переменную — вставьте туда ВЕСЬ
# содержимое JSON-ключа сервисного аккаунта одной строкой. Если задана — имеет
# приоритет над GOOGLE_CREDENTIALS_FILE.
GOOGLE_CREDENTIALS_JSON=

# Случайная строка для подписи сессий Flask (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# true — включает обход Telegram-авторизации через ?dev_id=... для локальной отладки в браузере
DEV_MODE=false

# Локально слушаем этот порт. На Railway переменную PORT назначает сама
# платформа — вручную её задавать/менять там не нужно.
PORT=5000

# Вебхук (необязательно) — при отправке анкеты данные POST'ятся сюда JSON'ом.
# Если оставить пустым, отправка просто выключена, регистрация в клубе
# работает как обычно.
WEBHOOK_URL=

# Общий секрет для входящих вебхуков от salebot — /api/webhooks/salebot
# (связка telegram_id<->sb_id) и /api/webhooks/salebot/subscription
# (подтверждение оплаты подписки, переводит в статус "резидент"). Salebot
# должен слать запрос с ?token=<это значение> в URL. Если оставить пустым,
# оба эндпоинта принимают запросы без проверки — заполните перед тем как
# сообщать боевой URL salebot'у.
INCOMING_WEBHOOK_SECRET=

# Продамус (payform.ru) — оплата участия в мероприятиях.
# Домен своей платёжной страницы (Личный кабинет Продамуса).
PRODAMUS_URL=https://demo.payform.ru/
# Секретный ключ (Личный кабинет → Настройки → Интеграция). Без него оплата
# работать не будет — эндпоинт вернёт ошибку конфигурации.
PRODAMUS_SECRET=
# Куда вернуть пользователя после оплаты/отмены — обычно чат с ботом.
PRODAMUS_RETURN_URL=https://t.me/your_bot
